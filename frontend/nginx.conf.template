# Rendered at container start by the nginx image's envsubst step
# (/docker-entrypoint.d/20-envsubst-on-templates.sh). Only the variables
# defined in the environment (BACKEND_HOST, BACKEND_PORT, NGINX_RESOLVER,
# CLIENT_MAX_BODY_SIZE) are substituted; nginx's own $vars are left alone.
server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend through Docker's embedded DNS at request time instead
    # of once at startup. A static upstream made nginx (a) refuse to start when
    # the backend container was not up yet and (b) keep proxying to a dead IP
    # after the backend was redeployed ("connect() failed (111)" -> 502/499).
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;
    set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};

    # Document uploads go through this proxy; nginx's 1 MB default rejected
    # most PDFs with 413. Backend limit is 50 MB, plus multipart overhead.
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API proxy: /api/foo -> backend /foo. "^~" stops the regex/static
    # locations below from ever capturing an /api/ request.
    location ^~ /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Never serve dotfiles (scanners probe /.env, /.git/config, ...).
    location ~ /\. {
        access_log off;
        log_not_found off;
        return 404;
    }

    # Vite's hashed bundles: safe to cache forever, and a missing chunk is a
    # real 404 rather than index.html served as JavaScript.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /favicon.ico {
        try_files /favicon.svg =204;
        access_log off;
        log_not_found off;
    }

    # The SPA shell must never be cached, otherwise browsers keep pointing at
    # bundles from the previous deploy.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA fallback for client-side routes (/library, /results, ...).
    location / {
        try_files $uri $uri/ /index.html;
    }
}
