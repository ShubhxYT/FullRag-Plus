# === LLM Provider Keys (at least one required) ===
# OpenCode Go (default provider when set): https://opencode.ai/docs/go/
OPENCODE_API_KEY=your-opencode-go-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# === Database ===
# For local dev: use localhost
# For Docker Compose: use "db" (the service name)
DATABASE_URL=postgresql+psycopg://fullrag:fullrag@localhost:5432/fullrag

# === Generation Settings ===
# opencode | groq | gemini (unset = auto: opencode if OPENCODE_API_KEY is set)
GENERATION_PROVIDER=opencode
GENERATION_MODEL=gemini-2.5-flash
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=2048

# === OpenCode Go (if GENERATION_PROVIDER=opencode) ===
# Models: curl https://opencode.ai/inference/go/v1/models
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_FALLBACK_MODELS=
OPENCODE_REASONING_EFFORT=low
# Try the Groq chain below when OpenCode fails
GROQ_FALLBACK_ENABLED=true

# === Context budgets (defaults follow the provider) ===
# MAX_CONTEXT_TOKENS=128000
# OVERVIEW_CONTEXT_TOKENS=200000
# SMALL_LIBRARY_DOCS=40
# MAP_REDUCE_CONCURRENCY=8
# MAP_REDUCE_DOC_TOKENS=30000

# === Retrieval quality ===
RERANKER=cross-encoder
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=40
MMR_LAMBDA=0.7
QUERY_REWRITE_ENABLED=true
DOCUMENT_SUMMARIES_ENABLED=true
SUMMARY_BACKFILL_ON_STARTUP=true

# === Groq (if GENERATION_PROVIDER=groq, or as OpenCode fallback) ===
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model + fallbacks tried in order when a model is missing or
# rate-limited. Check what your key can use:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# gpt-oss reasoning effort: low | medium | high
GROQ_REASONING_EFFORT=low

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/app/logs/fullrag.log

# === Cache ===
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
RESPONSE_CACHE_ENABLED=true

# === Evaluation ===
CONTINUOUS_EVAL_ENABLED=true
EVAL_SCHEDULE_INTERVAL_HOURS=24

# === Transcript Fallback ===
TRANSCRIPT_FALLBACK_ENABLED=true
TRANSCRIPT_PATH=data/transcript.md
