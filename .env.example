# === LLM Provider Keys (at least one required) ===
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# === Database ===
# For local dev: use localhost
# For Docker Compose: use "db" (the service name)
DATABASE_URL=postgresql+psycopg://fullrag:fullrag@localhost:5432/fullrag

# === Generation Settings ===
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash
GENERATION_TEMPERATURE=0.3
GENERATION_MAX_TOKENS=2048

# === Groq (if GENERATION_PROVIDER=groq) ===
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Primary model + fallbacks tried in order when a model is missing or
# rate-limited. Check what your key can use:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# gpt-oss reasoning effort: low | medium | high
GROQ_REASONING_EFFORT=low

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/app/logs/fullrag.log

# === Cache ===
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
RESPONSE_CACHE_ENABLED=true

# === Evaluation ===
CONTINUOUS_EVAL_ENABLED=true
EVAL_SCHEDULE_INTERVAL_HOURS=24

# === Transcript Fallback ===
TRANSCRIPT_FALLBACK_ENABLED=true
TRANSCRIPT_PATH=data/transcript.md
